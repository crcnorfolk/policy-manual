---
// Overrides Starlight's page title so that every policy shows its governance
// block directly under the heading: when it takes effect, who approved it,
// when, and what it replaces.
//
// Pages carrying no governance metadata render the title alone, so ordinary
// pages such as the home page are unaffected.
const route = (Astro.locals as any).starlightRoute;
const entry = route?.entry;
const data: Record<string, any> = entry?.data ?? {};

const REPO = 'https://github.com/crcnorfolk/policy-manual';

// Path of the source file, used to build the revision-history link.
const filePath: string | undefined =
  entry?.filePath ?? (entry?.id ? `src/content/docs/${entry.id}` : undefined);
const historyUrl = filePath ? `${REPO}/commits/main/${filePath}` : `${REPO}/commits/main`;

// Render the governance block for anything carrying governance metadata, not
// just numbered policies. The constitution and bylaws have no policy number -
// they are adopted by congregational vote and sit above the policy scheme - but
// they still need their effective date, approving body and revision history on
// the page. Ordinary pages (home, how-to-edit) carry none of these fields and
// are unaffected.
const isPolicy = Boolean(data.policy_number || data.effective || data.approved_by);
const status: string = data.status ?? 'draft';

const fmt = (d: unknown) =>
  d instanceof Date
    ? d.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : undefined;

const rows: Array<[string, string]> = [];
if (data.policy_number) rows.push(['Policy number', String(data.policy_number)]);
if (fmt(data.effective)) rows.push(['Effective', fmt(data.effective)!]);
if (data.approved_by) rows.push(['Approved by', String(data.approved_by)]);
if (fmt(data.approved_on)) rows.push(['Approved on', fmt(data.approved_on)!]);
if (fmt(data.retired_on)) rows.push(['Retired on', fmt(data.retired_on)!]);
if (data.supersedes) rows.push(['Supersedes', String(data.supersedes)]);
if (data.minutes) rows.push(['Recorded in', String(data.minutes)]);
if (data.review_cycle) rows.push(['Review', String(data.review_cycle)]);
---

<div class="policy-title">
  <h1 id="_top">{route?.entry?.data?.title}</h1>
  {
    isPolicy && (
      <div class="policy-governance" data-status={status}>
        {status === 'draft' && (
          <p class="policy-banner policy-banner--draft">
            <strong>Draft.</strong> This policy has not been approved and is not in
            force. It is published here so it can be read and revised before it goes
            to the board.
          </p>
        )}
        {status === 'retired' && (
          <p class="policy-banner policy-banner--retired">
            <strong>Retired.</strong> This policy is no longer in force. It is kept
            here so the record stays complete.
          </p>
        )}
        {rows.length > 0 && (
          <dl class="policy-meta">
            {rows.map(([label, value]) => (
              <div class="policy-meta__row">
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        )}
        <p class="policy-history">
          <a href={historyUrl} rel="noopener">
            View revision history
          </a>
          <span class="policy-history__note">
            Every change to this policy, with the date and who made it.
          </span>
        </p>
      </div>
    )
  }
</div>
